+    /** Single-use read/combined-scope rotation, pinned to ORIGINAL approved scope.
+     * Combined-scope rotation atomically rebinds the ORIGINAL passkey consent
+     * to the freshly minted bearer. No read token can ever gain write scope.
+     * The native MCP host MUST still check the owner registry on each request.
+     */
+    public static function refresh(PDO $db,string $refreshToken,array $client,int $now,?string $requestedScope=null):array
+    {
+        self::sqlite($db);self::client($client);
+        if(!self::secretFormat($refreshToken))self::denied();
+        $db->exec('BEGIN IMMEDIATE');
+        try {
+            $hash=hash('sha256',$refreshToken);
+            $q=$db->prepare('SELECT * FROM mirage_oauth_refresh_tokens WHERE refresh_hash=?');
+            $q->execute([$hash]);$r=$q->fetch(PDO::FETCH_ASSOC);
+            if(!$r || (int)$r['consumed']!==0 || (int)$r['revoked']!==0
+                || (int)$r['issued_at']>$now || (int)$r['expires_at']<=$now
+                || $r['client_id']!==$client['client_id']
+                || $r['connector_id']!==$client['connector_id']
+                || $r['host_evidence_id']!==$client['host_evidence_id']
+                || $r['resource']!==self::RESOURCE
+                || !in_array($r['scope'],[self::SCOPE,self::COMBINED_SCOPE],true)
+                || ($requestedScope!==null && $requestedScope!==$r['scope'])
+                || !self::hex64($r['owner_binding'])
+                || !self::hex64($r['credential_fingerprint']))self::denied();
+            $q=$db->prepare('SELECT * FROM mirage_oauth_tokens WHERE token_hash=?');
+            $q->execute([$r['parent_access_hash']]);$parent=$q->fetch(PDO::FETCH_ASSOC);
+            if(!$parent || (int)$parent['revoked']!==0
+                || $parent['client_id']!==$r['client_id']
+                || $parent['connector_id']!==$r['connector_id']
+                || $parent['host_evidence_id']!==$r['host_evidence_id']
+                || $parent['resource']!==self::RESOURCE
+                || $parent['scope']!==$r['scope']
+                || $parent['owner_binding']!==$r['owner_binding']
+                || $parent['credential_fingerprint']!==$r['credential_fingerprint'])self::denied();
+            if($r['scope']===self::COMBINED_SCOPE) {
+                $q=$db->prepare('SELECT COUNT(*) AS consent_count, MIN(consent_ref) AS consent_ref
+                    FROM mirage_oauth_write_consents
+                    WHERE token_hash=? AND owner=? AND namespace=?
+                    AND client_id=? AND connector_id=? AND owner_binding=?
+                    AND credential_fingerprint=? AND revoked_at IS NULL
+                    AND approved_at<=?');
+                $q->execute([$r['parent_access_hash'],'mirage-owner','project',
+                    $r['client_id'],$r['connector_id'],$r['owner_binding'],
+                    $r['credential_fingerprint'],$now]);
+                $consent=$q->fetch(PDO::FETCH_ASSOC);
+                if(!$consent || (int)$consent['consent_count']!==1 || !is_string($consent['consent_ref']))self::denied();
+            }
+            $q=$db->prepare('UPDATE mirage_oauth_refresh_tokens
+                SET consumed=1 WHERE refresh_hash=? AND consumed=0 AND revoked=0');
+            $q->execute([$hash]);if($q->rowCount()!==1)self::denied();
+            $access=self::secret();$next=self::secret();$accessHash=hash('sha256',$access);
+            $q=$db->prepare('INSERT INTO mirage_oauth_tokens
+                (token_hash,client_id,connector_id,host_evidence_id,resource,scope,
+                 owner_binding,credential_fingerprint,issued_at,expires_at)
+                 VALUES(?,?,?,?,?,?,?,?,?,?)');
+            $q->execute([$accessHash,$r['client_id'],$r['connector_id'],
+                $r['host_evidence_id'],self::RESOURCE,$r['scope'],
+                $r['owner_binding'],$r['credential_fingerprint'],$now,$now+3600]);
+            if($r['scope']===self::COMBINED_SCOPE) {
+                $q=$db->prepare('UPDATE mirage_oauth_write_consents
+                    SET token_hash=? WHERE consent_ref=? AND token_hash=?
+                    AND revoked_at IS NULL');
+                $q->execute([$accessHash,$consent['consent_ref'],$r['parent_access_hash']]);
+                if($q->rowCount()!==1)self::denied();
+            }
+            $q=$db->prepare('INSERT INTO mirage_oauth_refresh_tokens
+                (refresh_hash,client_id,connector_id,host_evidence_id,resource,scope,
+                 owner_binding,credential_fingerprint,issued_at,expires_at,parent_access_hash)
+                 VALUES(?,?,?,?,?,?,?,?,?,?,?)');
+            $q->execute([hash('sha256',$next),$r['client_id'],$r['connector_id'],
+                $r['host_evidence_id'],self::RESOURCE,$r['scope'],$r['owner_binding'],
+                $r['credential_fingerprint'],$now,$now+self::REFRESH_TTL,$accessHash]);
