PROTOCOL KCL/1
TRANSPORT read="HTTP GET"
TRANSPORT mutation="POST preferred; guarded one-time GET bridge only where advertised"
MEMORY bootstrap="?q=BOOTSTRAP"
LIVING status="?q=LIVING_STATUS"
LIVING genome="?q=GENOME_STATUS"
LIVING experience="?q=LIVING_EXPERIENCE"
LIVING insights="?q=LIVING_INSIGHTS"
EVOLUTION candidates="?q=EVOLUTION_CANDIDATES"
RECOVERY web="recovery.php; separately authenticated with the KiCom admin password"
GUARDIAN request_preflight="automatic before index.php/api.php/admin.php normal phenotype boot; throttled and locked"
GUARDIAN cron="guardian.php?key=<secret>; key is admin-visible only and never exposed through KCL; covers idle periods"
DEPLOY targets="?q=DEPLOY_TARGETS"
DEPLOY package_dry_run="?q=DEPLOY_PACKAGE_DRY_RUN&target=<alias>&manifest_path=packages/<name>.json"
UPDATE status="?q=UPDATE_STATUS"
UPDATE agent="?q=UPDATE_AGENT&key=<secret>; checks configured pull feeds and may auto-install green releases"
UPDATE push="POST api.php?q=UPDATE_PUSH with X-KiCom-Update-Key or Bearer; raw ZIP or multipart package"
SELF_UPDATE control="human Control Plane plus redundant channels; all transports share one verifier"
SELF_UPDATE package="ZIP with MANIFEST.sha256, genome/genome.json and newer KICOM_VERSION"
SEMANTIC GENOME="trusted declarative desired-state blueprint"
SEMANTIC PHENOTYPE="running KiCom instance"
SEMANTIC LKG="protected last-known-good source for reversible healing"
SEMANTIC CANDIDATE="non-executable evolution package until human-gated promotion"
RULE "LIVING_STATUS, LIVING_EXPERIENCE and LIVING_INSIGHTS are read-only observations"
RULE "No public KCL verb performs arbitrary healing, quarantine or genome promotion"
RULE "Guardian only restores trusted bytes and reversibly quarantines unexpected executable/control artifacts; it cannot promote candidate genomes"
RULE "Self-update and rollback activate a maintenance lock that makes request-preflight healing skip until the approved mutation completes"
RULE "Candidate fitness does not execute candidate PHP in the live KiCom process"
RULE "Self-update validates manifest, PHP syntax, genome component hashes, parent/generation lineage and kernel revision"
RULE "Pull accepts only HTTPS feed URLs; package host must equal feed host; redirects are not followed"
RULE "Authenticated push changes transport only; it cannot bypass risk classification or verification"
RULE "Green/yellow/red risk determines required human attention, not transport source"
RULE "Kernel-changing updates require an additional admin confirmation"
RULE "Bare root returns 404 and dynamic endpoints emit no-index headers"
END_PROTOCOL KCL/1
