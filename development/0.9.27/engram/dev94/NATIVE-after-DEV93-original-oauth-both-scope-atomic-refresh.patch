+    /** READ-only readiness check: an existing malformed schema fails closed. */
+    private static function refreshSchemaReady(PDO $db):bool
+    {
+        $q=$db->query("SELECT name FROM sqlite_master WHERE type='table' AND name='mirage_oauth_refresh_tokens'");
+        if($q->fetchColumn()===false)return false;
+        $db->query('SELECT refresh_hash,client_id,connector_id,host_evidence_id,
+           resource,scope,owner_binding,credential_fingerprint,issued_at,
+           expires_at,consumed,revoked,parent_access_hash
+           FROM mirage_oauth_refresh_tokens LIMIT 0');
+        return true;
+    }
