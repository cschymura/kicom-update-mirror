PROTOCOL KCL/1
SYNTAX response_header="KCL/1"
SYNTAX result="OK|READY|WARN|ERROR <operation>"
SEMANTIC FACT="verified observation"
SEMANTIC READY="accepted but bounded further authorization is required"
AUTH session_open="?q=AUTH_SESSION_OPEN&code=<6digits>"
AUTH status="?q=AUTH_STATUS"
AUTH critical_prepare="?q=AUTH_APPROVAL_PREPARE&action=self_update_install&session_id=<id>&token=<rolling>"
AUTH critical_execute="?q=AUTH_APPROVAL_EXECUTE&approval_id=<id>&code=<6digits>"
AUTONOMY source_list="?q=AUTONOMY_SOURCE_LIST&session_id=<id>&token=<rolling>"
AUTONOMY source_read="?q=AUTONOMY_SOURCE_READ&path=<manifest-path>&offset=<n>&session_id=<id>&token=<rolling>"
AUTONOMY upload="AUTONOMY_UPLOAD_BEGIN -> CHUNK -> FINISH"
AUTONOMY deploy="?q=AUTONOMY_DEPLOY&target=<alias>&..."
ARCHIVE status="?q=ARCHIVE_STATUS"
RULE "Every authenticated autonomy request consumes its token and returns the next token"
RULE "TOTP is current-step only, one-use, 30 seconds, 6 digits"
RULE "Critical approvals bind action, target/version and SHA-256 before TOTP execution"
RULE "Legacy proposal/admin interfaces remain available as recovery paths"
END_PROTOCOL KCL/1
