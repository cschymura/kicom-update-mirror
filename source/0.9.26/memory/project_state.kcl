PROJECT kicom
VERSION "0.9.26"
STATE active
FACT canonical_name="KiCom"
FACT purpose="Persistent self-extending AI work environment and controlled HTTPS/KCL gateway"
FACT protocol="KCL/1"
FACT mode="living-architecture-with-bounded-autonomy"
FACT genome_id="kicom-0.9.26-g25r2"
FACT genome_generation=25
FACT direct_shell=false
FACT arbitrary_remote_fetch=false
FACT production_write="allowlisted-human-approved"
FACT autonomy_envelope="dev-passkey+bounded-internal-self-authoring; legacy-freeotp-session-fallback"
