DECISIONS kicom
DECISION D001 status=accepted title="Use HTTPS/KCL as the controlled gateway"
DECISION D002 status=accepted title="Keep canonical project memory server-side and versioned"
DECISION D003 status=accepted title="Human approval for meaningful side effects and new authority"
DECISION D004 status=accepted title="Use SHA-256 conflict protection and complete pre-write backups"
DECISION D005 status=accepted title="Keep deployment targets human-configured and roots protocol-invisible"
DECISION D006 status=accepted title="Require production healthchecks and explicit target confirmation"
DECISION D007 status=accepted title="Use explicit manifests for transactional multi-file deployment"
DECISION D008 status=accepted title="Make KiCom non-indexable and non-descriptive at the bare root"
DECISION D009 status=accepted title="Self-update only through verified, human-gated packages"
DECISION D010 status=accepted title="Preserve var and stage runtime data across code updates; allow only their deny-sentinel .htaccess files as genome-managed security components"
DECISION D011 status=accepted title="Separate genome, memory and phenotype"
RATIONALE D011 "Desired state, learned experience and running state have different trust roles"
DECISION D012 status=accepted title="Use a standalone recovery kernel as root of trust"
RATIONALE D012 "A damaged normal core must still be diagnosable and repairable without loading lib.php"
DECISION D013 status=accepted title="Permit autonomous reversible healing toward trusted state"
RATIONALE D013 "Restoring a known-good byte sequence is bounded and auditable; inventing new runtime authority is not"
DECISION D014 status=accepted title="Store Last-Known-Good copies and a trusted backup of the genome"
RATIONALE D014 "Healing must remain possible even if the live genome file itself is damaged"
DECISION D015 status=accepted title="Quarantine unknown or divergent artifacts before reuse"
DECISION D016 status=accepted title="Do not auto-heal the recovery kernel"
RATIONALE D016 "The root of trust must not rewrite itself through ordinary runtime healing"
DECISION D017 status=accepted title="Support automated guardian scans with a secret URL-Cron key"
RATIONALE D017 "Shared hosting can perform periodic healing without shell access"
DECISION D018 status=accepted title="Record healing and evolution as structured experience events"
DECISION D018A status=accepted title="Derive deterministic learning insights from recurring experience patterns"
RATIONALE D018A "KiCom can surface evidence-backed hypotheses without granting the runtime authority to invent or promote code"
DECISION D019 status=accepted title="Allow controlled evolution through candidate genomes"
RATIONALE D019 "Candidates may be generated and assessed in isolation; promotion into the live organism remains human-gated"
DECISION D020 status=accepted title="Track genome ancestry and fitness evidence"
DECISION D021 status=accepted title="Use ChatGPT as the initial external development cortex"
RATIONALE D021 "Reasoning and candidate generation remain outside the trusted runtime while KiCom observes, remembers, tests and heals"
DECISION D022 status=accepted title="Require extra confirmation for recovery-kernel changes"
DECISION D023 status=accepted title="Recursively detect unexpected executable/control artifacts outside var and stage"
RATIONALE D023 "An unexpected executable in a subdirectory is as relevant as one in the root and must not evade the immune scan"
DECISION D024 status=accepted title="Allow Guardian to auto-quarantine unknown artifacts reversibly"
RATIONALE D024 "Quarantine removes immediate exposure while preserving bytes for forensic review; it does not grant trust or execute the artifact"
DECISION D025 status=accepted title="Trigger immune preflight automatically before normal core requests"
RATIONALE D025 "Known trusted damage should be repaired before the ordinary phenotype boots, without requiring an operator click"
DECISION D026 status=accepted title="Pause immune healing during legitimate self-update mutation"
RATIONALE D026 "A maintenance lock distinguishes approved genome transition from accidental drift"
DECISION D027 status=accepted title="Serialize autonomous healing and verify PHP syntax after repair"
RATIONALE D027 "Parallel heal races are prevented and the restored phenotype is parsed before being declared healthy"
DECISION D029 status=accepted title="Use redundant update transports with one common trust path"
RATIONALE D029 "Pull and Push provide availability/failover; neither may bypass the same package, Genome, lineage, backup and health verification"
DECISION D030 status=accepted title="Make human attention proportional to risk"
RATIONALE D030 "Routine deterministic work should be automatic; yellow changes need one deliberate click; trust-boundary changes remain explicit"
DECISION D031 status=accepted title="Use an attention-first Control Plane"
RATIONALE D031 "Human concentration is limited; clarity and progressive disclosure reduce operational errors"
DECISION D032 status=accepted title="Keep manual upload as recovery channel even after automation"
RATIONALE D032 "A separate local fallback remains valuable when Pull or Push transport is unavailable"
END_DECISIONS kicom
