FACT github_role="optional-mirror-not-authority"
FACT first_party_targets="sandbox,kicomarchive,updatefeed"
FACT release_archive="append-only-install+update+source+hashes+metadata"
FACT read_lease="trusted-source-only, ttl600, max_uses64, nonrotating"
FACT compact_get_batch="up to 16 exact patch operations, one session rotation"
FACT release_prepare="server-side semver and genome-lineage preparation"
FACT canonical_memory_via="?q=BOOTSTRAP"
MILESTONE "Goal Layer and append-only ChatGPT memory archive" status=passed version="0.9.5"
MILESTONE "Autonomy Envelope and Human Authorization Bridge" status=implemented version="0.9.6"
MILESTONE "Fast transport" status=implemented version="0.9.8"
MILESTONE "Low-roundtrip control plane" status=implemented version="0.9.9"
MILESTONE "Transaction buffer and resilient bound approvals" status=implemented version="0.9.10"
MILESTONE "Adaptive transport sizing" status=implemented version="0.9.11"
FACT session_open_totp_grace="legacy fallback only; current plus previous 2 FreeOTP counters by default with one-use replay protection"
MILESTONE "Session TOTP grace" status=implemented version="0.9.12"
FACT chat_update_transport="first-class direct ChatGPT transport; server-side build or direct ZIP transfer"
FACT chat_update_modes="SERVER_SIDE_BUILD,CHUNKED_DIRECT,RAW_POST_DIRECT"
FACT chat_update_dependency="no Slack, mail or GitHub required"
FACT chat_update_verifier="same self-update manifest/SHA/PHP/genome/lineage/risk/backup/healthcheck path"
FACT chat_update_max_zip_bytes=8388608
FACT canonical_memory_max_resource_bytes=32768
RULE "Transport capability should be broad and simple; authority is enforced at the actual protected action boundary."
RULE "A newer verified pending update supersedes older pending metadata by archiving it rather than silently deleting history."
FACT operational_memory="SQLite-primary protected var/db/kicom.sqlite"
FACT sqlite_mode="WAL, foreign_keys ON, busy_timeout 5000, synchronous NORMAL"
FACT sqlite_compatibility="legacy JSON/JSONL retained as dual-write and rebuild mirrors"
FACT sqlite_healing="quick_check, integrity_check, snapshots, quarantine, restore and mirror rebuild"
FACT sqlite_evolution="shadow DB, measured fitness, integrity gate, transactional promotion, snapshots"
FACT sqlite_boundaries="Canonical KCL, Genome, secrets and immutable archive authority stay outside SQLite"
FACT dev_zone="trusted genome-covered modules; WebAuthn passkey; reusable DEV-only session"
FACT slack_transport="bounded redundant transport; never authority; requires configured bot/signing secrets"
FACT mail_transport="bounded redundant transport; never authority; IMAPS/SMTPS configured separately"
FACT browser_transport="Opera-compatible DEV/Admin control surface; never authority"
FACT authority_model="technical risk classification is separate from authority boundary"
FACT internal_red_totp_gate=false
FACT production_external_authority="human-protected"
FACT legacy_bootstrap_invariant="critical-actions-totp-bound is retained only for the 0.9.25 installer transition"
RULE "Internal reversible KiCom work is not TOTP-gated solely because technical risk is RED."
RULE "Production targets, credentials, new external recipients and protected foreign systems remain human-authorized."
RULE "Verifier, SHA-256, backup, healthcheck, rollback, TLS and trust-root controls remain mandatory."
RULE "SQLite is primary operational memory, not the sole root of trust."
END_PROJECT kicom
